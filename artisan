#!/usr/bin/env php
<?php

/**
 * Travelbookings — Artisan CLI (Core PHP Edition)
 */

define('LARAVEL_START', microtime(true));

$app = require_once __DIR__ . '/bootstrap/app.php';

// Load routes for CLI introspection
require_once __DIR__ . '/routes/web.php';

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'list';

switch ($command) {
    case 'serve':
        $host = '127.0.0.1';
        $port = '8000';
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--host=')) {
                $host = substr($arg, 7);
            }
            if (str_starts_with($arg, '--port=')) {
                $port = substr($arg, 7);
            }
        }
        echo "\033[32m   INFO  Server running on [http://{$host}:{$port}].\033[0m\n\n";
        echo "  Press Ctrl+C to stop the server\n\n";
        passthru(sprintf('php -S %s:%s server.php', escapeshellarg($host), escapeshellarg($port)));
        break;

    case 'route:list':
        $routes = App\Core\Router::getRoutes();
        echo "\n\033[1;33m+--------+---------------------------------------+-----------------------------+----------------------------------------------+\033[0m\n";
        echo sprintf(
            "\033[1;37m| %-6s | %-37s | %-27s | %-44s |\033[0m\n",
            'Method', 'URI', 'Name', 'Action'
        );
        echo "\033[1;33m+--------+---------------------------------------+-----------------------------+----------------------------------------------+\033[0m\n";

        foreach ($routes as $r) {
            $actionStr = '';
            if (is_array($r->action)) {
                $shortClass = basename(str_replace('\\', '/', $r->action[0]));
                $actionStr = $shortClass . '@' . $r->action[1];
            } elseif (is_string($r->action)) {
                $actionStr = $r->action;
            } else {
                $actionStr = 'Closure';
            }

            echo sprintf(
                "| \033[32m%-6s\033[0m | %-37s | \033[36m%-27s\033[0m | %-44s |\n",
                $r->method,
                $r->path,
                $r->name ?? '',
                $actionStr
            );
        }
        echo "\033[1;33m+--------+---------------------------------------+-----------------------------+----------------------------------------------+\033[0m\n\n";
        break;

    case '--version':
    case '-V':
        echo "Travelbookings Framework (Core PHP Laravel Architecture) 1.0.0\n";
        break;

    case 'list':
    default:
        echo "\n\033[32mTravelbookings Artisan (Core PHP Edition)\033[0m\n\n";
        echo "\033[33mUsage:\033[0m\n";
        echo "  php artisan <command> [options]\n\n";
        echo "\033[33mAvailable commands:\033[0m\n";
        echo "  \033[32mserve\033[0m          Serve the application on the PHP development server (default: 127.0.0.1:8000)\n";
        echo "  \033[32mroute:list\033[0m     List all registered application routes\n";
        echo "  \033[32m--version\033[0m      Display application framework version\n\n";
        break;
}

